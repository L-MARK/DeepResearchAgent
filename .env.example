# === LLM ===
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:13000/v1
OPENAI_LLM_MODEL=gpt-4o
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_EMBEDDING_BATCH_SIZE=10
TEMPERATURE=0
MAX_TOKENS=2000

# === Local application ===
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FASTAPI_WORKERS=1
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
ARTIFACT_ROOT=./data/artifacts
SKILLS_ROOT=./skills
AUTO_RESUME_RUNS=true

# === Web retrieval ===
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=45
TAVILY_CACHE_TTL_SECONDS=86400

# === Harness budgets ===
RUN_MAX_WALL_TIME_SECONDS=1800
RUN_MAX_PLAN_TASKS=8
RUN_MAX_TOOL_CALLS=30
RUN_MAX_TAVILY_CALLS=20
RUN_MAX_REPLANS=2
RUN_MAX_TASK_RETRIES=2
RUN_MAX_LLM_TOKENS=200000
RUN_MAX_CONCURRENCY=4
RUN_TOOL_TIMEOUT_SECONDS=60

# === Context and memory ===
CONTEXT_MAX_CHARS=16000
CONTEXT_MAX_TOKENS=12000
CONTEXT_RECENT_TURNS=8
CONTEXT_COMPRESSION_THRESHOLD_TOKENS=8000
CONTEXT_COMPRESSION_THRESHOLD_RATIO=0.50
CONTEXT_COMPRESSION_TARGET_TOKENS=2000
CONTEXT_PROTECT_RECENT_MESSAGES=12
SESSION_SEARCH_TOP_K=3
SESSION_SEARCH_WINDOW=5
MEMORY_USER_MAX_TOKENS=500
MEMORY_PROJECT_MAX_TOKENS=800
MEMORY_USER_MAX_CHARS=1375
MEMORY_PROJECT_MAX_CHARS=2200
MEMORY_BACKGROUND_REVIEW_ENABLED=true
MEMORY_LLM_MODEL=
MEMORY_LLM_MIN_CONFIDENCE=0.75
MEMORY_LLM_MAX_CANDIDATES=3
MEMORY_LLM_MAX_MESSAGE_CHARS=4000
MEMORY_LLM_MAX_OUTPUT_TOKENS=1200

# === Cache ===
CACHE_ROOT=./cache
MODEL_CACHE_ROOT=./cache
CACHE_DIR=./cache
CACHE_EMBEDDING_PROVIDER=sentence_transformer
CACHE_SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
CACHE_MEMORY_ONLY=false
CACHE_MAX_MEMORY_SIZE=100
CACHE_MAX_DISK_SIZE=1000
CACHE_THREAD_SAFE=true
CACHE_ENABLE_VECTOR_SIMILARITY=true
CACHE_SIMILARITY_THRESHOLD=0.9
CACHE_MAX_VECTORS=10000

# === Agent and planner ===
AGENT_RECURSION_LIMIT=5
AGENT_CHUNK_SIZE=4
AGENT_STREAM_FLUSH_THRESHOLD=40
DEEP_AGENT_STREAM_FLUSH_THRESHOLD=80
MA_PLANNER_MAX_TASKS=6
MA_ALLOW_UNCLARIFIED_PLAN=true
MA_DEFAULT_DOMAIN=通用
MA_DEFAULT_REPORT_TYPE=long_document
MA_ENABLE_CONSISTENCY_CHECK=true
MA_ENABLE_MAPREDUCE=true
MA_MAPREDUCE_THRESHOLD=20
MA_MAX_TOKENS_PER_REDUCE=4000
MA_ENABLE_PARALLEL_MAP=true
MA_SECTION_MAX_EVIDENCE=8
MA_SECTION_MAX_CONTEXT_CHARS=800
MA_WORKER_EXECUTION_MODE=sequential
MA_WORKER_MAX_CONCURRENCY=4
MA_REFLECTION_ALLOW_RETRY=false
MA_REFLECTION_MAX_RETRIES=1

# === Reporting and learning ===
EVIDENCE_CARD_MAX_TOKENS=200
EVIDENCE_CARD_BATCH_SIZE=10
REPORT_SECTION_EVIDENCE_BUDGET=12000
REPORT_BATCH_BUDGET_RATIO=0.70
REPORT_BATCH_DIGEST_MAX_TOKENS=600
REPORT_MAX_SECTIONS=6
REPORT_MAX_MODEL_CALLS=15
REPORT_RESERVED_TOKENS=60000
VERIFICATION_RESERVED_TOKENS=15000
LEARNING_REVIEW_ENABLED=true
LEARNING_REVIEW_MODEL=
LEARNING_REVIEW_MAX_OUTPUT_TOKENS=4000
LEARNING_REVIEW_MAX_RETRIES=2
SKILL_WRITE_APPROVAL_REQUIRED=true
SKILL_CANARY_INITIAL_PERCENT=5
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
